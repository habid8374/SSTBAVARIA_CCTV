# PASO A PASO:
#  1. Renombrar este archivo de ".env.example" a ".env" (quitar el ".example").
#  2. En el dashboard: Sistema -> Equipo local -> en la fila de este equipo,
#     boton "Copiar" junto al API key.
#  3. Pegar ese valor abajo, en API_KEY= (sin espacios ni comillas).
# No versionar el .env real (ya esta en .gitignore) — trae una API key.

API_BASE_URL=https://sstbavaria-cctv-production.up.railway.app
API_KEY=

# Opcionales — estos son los valores por defecto:
# INTERVALO_SYNC_SEGUNDOS=60
# INTERVALO_DETECCION_SEGUNDOS=0.4
# CONFIANZA_MINIMA=0.5
# COOLDOWN_ZONA_SEGUNDOS=60
# MODELO_YOLO=yolov8n.pt
# TIMEOUT_HTTP_SEGUNDOS=10
# RECONEXION_SEGUNDOS=10
# LOG_LEVEL=INFO

# Grabación en disco (ver README → "Grabaciones y visor en vivo")
# GRABAR_VIDEO=true
# GRABACIONES_DIR=grabaciones
# GRABACIONES_DURACION_CLIP_MINUTOS=60
# GRABACIONES_FPS=3
# GRABACIONES_RETENCION_DIAS=15

# Visor web local (cámaras en vivo + grabaciones), en http://<ip-del-pc>:8090
# VISOR_WEB_ACTIVO=true
# VISOR_WEB_HOST=0.0.0.0
# VISOR_WEB_PUERTO=8090
# Usuario/contraseña del visor (HTTP Basic) — recomendado configurarlos.
# VISOR_WEB_USUARIO=
# VISOR_WEB_PASSWORD=

# Anuncio en la red (mDNS/Bonjour) para entrar por nombre en vez de IP —
# ver README → "Nombre en la red en vez de IP". Si hay más de un equipo
# local en la misma red, cada uno necesita un nombre distinto.
# VISOR_WEB_MDNS_ACTIVO=true
# VISOR_WEB_MDNS_NOMBRE=sstbavaria-camaras
